{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "skip-changelog": true,
  "always-update": true,
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore(release): v${version}",
  "pull-request-header": "Merging this PR releases libOBD2. The release agent stamps `[Unreleased]` in CHANGELOG.md as this version; edit `[Unreleased]` on `develop`, since this branch is rebuilt on every push there.",
  "release-as": "0.1.0",
  "packages": {
    ".": {
      "package-name": "libOBD2",
      "version-file": "version.txt"
    }
  }
}
